  "scripts": {
    "build": "nuxt build",
    "dev": "bun --bun nuxt dev",
    "preview": "bun --bun nuxt preview",
    "lint-staged": "lint-staged",
    "setup:dev": "docker compose up",
    "lint": "bun run --parallel --no-exit-on-error lint:oxlint lint:eslint format:check",
    "lint:fix": "bun run --parallel --no-exit-on-error lint:oxlint:fix lint:eslint:fix && oxfmt",
    "lint:oxlint": "oxlint",
    "lint:oxlint:fix": "oxlint --fix",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p server",
    "test": "vitest run",
    "postinstall": "nuxt prepare"
  },
